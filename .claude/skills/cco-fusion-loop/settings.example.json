{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(git push:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh pr edit:*)",
      "Bash(gh pr close:*)",
      "Bash(gh pr comment:*)",
      "Bash(gh pr review:*)",
      "Bash(gh issue create:*)",
      "Bash(gh issue comment:*)",
      "Bash(pkill:*)",
      "Bash(killall:*)",
      "Bash(amd-smi reset:*)",
      "Bash(amd-smi set:*)",
      "Bash(rocm-smi --gpureset:*)",
      "Bash(rocm-smi -r:*)",
      "Bash(rocm-smi --setsclk:*)",
      "Bash(rocm-smi --setperflevel:*)"
    ]
  }
}
