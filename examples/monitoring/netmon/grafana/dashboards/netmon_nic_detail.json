{
  "uid": "netmon-nic",
  "title": "netmon NIC detail",
  "tags": [
    "netmon",
    "ainic"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "2s",
      "5s",
      "10s",
      "30s",
      "1m",
      "5m"
    ]
  },
  "templating": {
    "list": [
      {
        "name": "experiment",
        "label": "experiment",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "netmon-vm"
        },
        "query": {
          "query": "query_result(last_over_time(netmon_import_info[3650d]))",
          "refId": "V"
        },
        "regex": "/experiment=\"([^\"]+)\"/",
        "refresh": 2,
        "sort": 1
      },
      {
        "name": "target",
        "label": "host/netdev",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "netmon-vm"
        },
        "query": {
          "query": "query_result(last_over_time(netmon_target_info{experiment=\"$experiment\"}[3650d]))",
          "refId": "V"
        },
        "regex": "/target=\"([^\"]+)\"/",
        "refresh": 2,
        "sort": 1,
        "multi": false,
        "includeAll": false
      },
      {
        "name": "min_step",
        "label": "min step, ms (low-res threshold)",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "netmon-vm"
        },
        "query": {
          "query": "query_result(max(last_over_time(netmon_step_ms{experiment=\"$experiment\"}[3650d])))",
          "refId": "V"
        },
        "regex": "/\\} ([0-9]+) /",
        "refresh": 2,
        "description": "Smallest window of the envelope/mean panels: 3 x the sampling baseline, the largest over the experiment's hosts"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "table",
      "title": "Target info (recording status, link speed)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "netmon-vm"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "netmon-vm"
          },
          "expr": "last_over_time(netmon_target_info{experiment=\"$experiment\",target=\"$target\"}[3650d])",
          "range": false,
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true,
              "__name__": true
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 3
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 2,
      "type": "table",
      "title": "Fixed experiment window summary (offline report rules; rates in Gb/s, coverage/above80 as fractions)",
      "description": "Numbers of the offline report's summary table for the fixed window [window_start, window_end] (the experiment's common window). They do not change with zoom.",
      "datasource": {
        "type": "prometheus",
        "uid": "netmon-vm"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "netmon-vm"
          },
          "expr": "(last_over_time(netmon_summary{experiment=\"$experiment\",target=\"$target\",stat=~\"avg|peak10ms|p99\"}[3650d]) * 8 / 1e9) or (last_over_time(netmon_summary{experiment=\"$experiment\",target=\"$target\",stat=~\"coverage|above80\"}[3650d])) or (last_over_time(netmon_summary{experiment=\"$experiment\",target=\"$target\",stat=~\"lowres_n|lowres_s\"}[3650d]))",
          "range": false,
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "groupingToMatrix",
          "options": {
            "columnField": "stat",
            "rowField": "row",
            "valueField": "Value"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 3
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "RDMA payload, Gb/s (envelope + mean per window ≥ ${min_step}ms)",
      "description": "Data with target status 'live' comes from ainic-netmon record --push: an online approximation of these rules; where a push failed the mean of that window may be off. Import the recording (ainic-netmon-import --replace) for the exact numbers.",
      "datasource": {
        "type": "prometheus",
        "uid": "netmon-vm"
      },
      "interval": "${min_step}ms",
      "maxDataPoints": 2000,
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "netmon-vm"
          },
          "expr": "max_over_time(netmon_rate{experiment=\"$experiment\",target=\"$target\",source=\"rdma\",counter=\"tx_rdma_ucast_bytes\",resolution=\"normal\"}[$__interval]) * 8 / 1e9",
          "legendFormat": "tx max",
          "range": true,
          "instant": false,
          "netmon": {
            "source": "rdma",
            "counter": "tx_rdma_ucast_bytes",
            "scale": 8e-09,
            "kind": "max"
          }
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "netmon-vm"
          },
          "expr": "min_over_time(netmon_rate{experiment=\"$experiment\",target=\"$target\",source=\"rdma\",counter=\"tx_rdma_ucast_bytes\",resolution=\"normal\"}[$__interval]) * 8 / 1e9",
          "legendFormat": "tx min",
          "range": true,
          "instant": false,
          "netmon": {
            "source": "rdma",
            "counter": "tx_rdma_ucast_bytes",
            "scale": 8e-09,
            "kind": "min"
          }
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "netmon-vm"
          },
          "expr": "(sum_over_time(netmon_increase{experiment=\"$experiment\",target=\"$target\",source=\"rdma\",counter=\"tx_rdma_ucast_bytes\",resolution=\"normal\"}[$__interval]) / sum_over_time(netmon_interval_seconds{experiment=\"$experiment\",target=\"$target\",source=\"rdma\",counter=\"tx_rdma_ucast_bytes\",resolution=\"normal\"}[$__interval])) * 8 / 1e9",
          "legendFormat": "tx mean",
          "range": true,
          "instant": false,
          "netmon": {
            "source": "rdma",
            "counter": "tx_rdma_ucast_bytes",
            "scale": 8e-09,
            "kind": "mean"
          }
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "netmon-vm"
          },
          "expr": "max_over_time(netmon_rate{experiment=\"$experiment\",target=\"$target\",source=\"rdma\",counter=\"tx_rdma_ucast_bytes\",resolution=\"low\"}[$__interval]) * 8 / 1e9",
          "legendFormat": "tx low-res",
          "range": true,
          "instant": false,
          "netmon": {
            "source": "rdma",
            "counter": "tx_rdma_ucast_bytes",
            "scale": 8e-09,
            "kind": "low"
          }
        },
        {
          "refId": "E",
          "datasource": {
            "type": "prometheus",
            "uid": "netmon-vm"
          },
          "expr": "max_over_time(netmon_rate{experiment=\"$experiment\",target=\"$target\",source=\"rdma\",counter=\"rx_rdma_ucast_bytes\",resolution=\"normal\"}[$__interval]) * 8 / 1e9",
          "legendFormat": "rx max",
          "range": true,
          "instant": false,
          "netmon": {
            "source": "rdma",
            "counter": "rx_rdma_ucast_bytes",
            "scale": 8e-09,
            "kind": "max"
          }
        },
        {
          "refId": "F",
          "datasource": {
            "type": "prometheus",
            "uid": "netmon-vm"
          },
          "expr": "min_over_time(netmon_rate{experiment=\"$experiment\",target=\"$target\",source=\"rdma\",counter=\"rx_rdma_ucast_bytes\",resolution=\"normal\"}[$__interval]) * 8 / 1e9",
          "legendFormat": "rx min",
          "range": true,
          "instant": false,
          "netmon": {
            "source": "rdma",
            "counter": "rx_rdma_ucast_bytes",
            "scale": 8e-09,
            "kind": "min"
          }
        },
        {
          "refId": "G",
          "datasource": {
            "type": "prometheus",
            "uid": "netmon-vm"
          },
          "expr": "(sum_over_time(netmon_increase{experiment=\"$experiment\",target=\"$target\",source=\"rdma\",counter=\"rx_rdma_ucast_bytes\",resolution=\"normal\"}[$__interval]) / sum_over_time(netmon_interval_seconds{experiment=\"$experiment\",target=\"$target\",source=\"rdma\",counter=\"rx_rdma_ucast_bytes\",resolution=\"normal\"}[$__interval])) * 8 / 1e9",
          "legendFormat": "rx mean",
          "range": true,
          "instant": false,
          "netmon": {
            "source": "rdma",
            "counter": "rx_rdma_ucast_bytes",
            "scale": 8e-09,
            "kind": "mean"
          }
        },
        {
          "refId": "H",
          "datasource": {
            "type": "prometheus",
            "uid": "netmon-vm"
          },
          "expr": "max_over_time(netmon_rate{experiment=\"$experiment\",target=\"$target\",source=\"rdma\",counter=\"rx_rdma_ucast_bytes\",resolution=\"low\"}[$__interval]) * 8 / 1e9",
          "legendFormat": "rx low-res",
          "range": true,
          "instant": false,
          "netmon": {
            "source": "rdma",
            "counter": "rx_rdma_ucast_bytes",
            "scale": 8e-09,
            "kind": "low"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "pointSize": 3
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "tx max"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#2a78d6"
                }
              },
              {
                "id": "custom.fillBelowTo",
                "value": "tx min"
              },
              {
                "id": "custom.fillOpacity",
                "value": 25
              },
              {
                "id": "custom.lineWidth",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "tx min"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#2a78d6"
                }
              },
              {
                "id": "custom.lineWidth",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "tx mean"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#2a78d6"
                }
              },
              {
                "id": "custom.lineWidth",
                "value": 1.5
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "tx low-res"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#2a78d6"
                }
              },
              {
                "id": "custom.drawStyle",
                "value": "points"
              },
              {
                "id": "custom.pointSize",
                "value": 6
              },
              {
                "id": "custom.showPoints",
                "value": "always"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "rx max"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#eb6834"
                }
              },
              {
                "id": "custom.fillBelowTo",
                "value": "rx min"
              },
              {
                "id": "custom.fillOpacity",
                "value": 25
              },
              {
                "id": "custom.lineWidth",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "rx min"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#eb6834"
                }
              },
              {
                "id": "custom.lineWidth",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "rx mean"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#eb6834"
                }
              },
              {
                "id": "custom.lineWidth",
                "value": 1.5
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "rx low-res"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#eb6834"
                }
              },
              {
                "id": "custom.drawStyle",
                "value": "points"
              },
              {
                "id": "custom.pointSize",
                "value": 6
              },
              {
                "id": "custom.showPoints",
                "value": "always"
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Raw points, Gb/s (one point per interval when the step is 1 ms; otherwise max per step — step: $__interval)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "netmon-vm"
      },
      "interval": "1ms",
      "maxDataPoints": 2000,
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "netmon-vm"
          },
          "expr": "max_over_time(netmon_rate{experiment=\"$experiment\",target=\"$target\",source=\"rdma\",counter=\"tx_rdma_ucast_bytes\",resolution=\"normal\"}[$__interval]) * 8 / 1e9",
          "legendFormat": "tx",
          "range": true,
          "instant": false,
          "netmon": {
            "kind": "raw",
            "source": "rdma",
            "counter": "tx_rdma_ucast_bytes",
            "scale": 8e-09
          }
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "netmon-vm"
          },
          "expr": "max_over_time(netmon_rate{experiment=\"$experiment\",target=\"$target\",source=\"rdma\",counter=\"rx_rdma_ucast_bytes\",resolution=\"normal\"}[$__interval]) * 8 / 1e9",
          "legendFormat": "rx",
          "range": true,
          "instant": false,
          "netmon": {
            "kind": "raw",
            "source": "rdma",
            "counter": "rx_rdma_ucast_bytes",
            "scale": 8e-09
          }
        }
      ],
