    {
      "id": 6,
      "type": "timeseries",
      "title": "Port wire bytes (IPC), Gb/s, all traffic incl. ACKs",
      "description": "Data with target status 'live' comes from ainic-netmon record --push: an online approximation of these rules; where a push failed the mean of that window may be off. Import the recording (ainic-netmon-import --replace) for the exact numbers.",
      "datasource": {
        "type": "prometheus",
        "uid": "netmon-vm"
      },
      "interval": "${min_step}ms",
      "maxDataPoints": 2000,
      "gridPos": {
        "x": 12,
        "y": 22,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "netmon-vm"
          },
          "expr": "max_over_time(netmon_rate{experiment=\"$experiment\",target=\"$target\",source=\"ipc\",counter=\"octets_tx_ok\",resolution=\"normal\"}[$__interval]) * 8 / 1e9",
          "legendFormat": "wire tx max",
          "range": true,
          "instant": false,
          "netmon": {
            "source": "ipc",
            "counter": "octets_tx_ok",
            "scale": 8e-09,
            "kind": "max"
          }
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "netmon-vm"
          },
          "expr": "min_over_time(netmon_rate{experiment=\"$experiment\",target=\"$target\",source=\"ipc\",counter=\"octets_tx_ok\",resolution=\"normal\"}[$__interval]) * 8 / 1e9",
          "legendFormat": "wire tx min",
          "range": true,
          "instant": false,
          "netmon": {
            "source": "ipc",
            "counter": "octets_tx_ok",
