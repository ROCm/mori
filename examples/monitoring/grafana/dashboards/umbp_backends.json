          "legendFormat": "{{tier}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "description": "Keys each medium currently owns, as reported by its own backend through the heartbeat.",
      "id": 11
    },
    {
      "type": "row",
      "title": "Storage backends \u2014 every medium, same panels",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 13
      },
      "panels": [],
      "id": 12
    },
    {
      "type": "timeseries",
      "title": "Operation rate by medium and op",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 14
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 0,
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": true
          },
          "color": {
            "mode": "palette-classic"
          },
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "sum by (tier, op) (rate(mori_umbp_backend_ops_total{node=~\"$node\", tier=~\"$tier\"}[$__rate_interval]))",
          "legendFormat": "{{tier}} {{op}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "description": "mori_umbp_backend_ops_total is emitted by the instrumentation decorator that wraps every MediumBackend, so a medium added later appears here without a dashboard edit.",
      "id": 13
    },
    {
      "type": "timeseries",
      "title": "Write bandwidth by medium",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 14
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 0,
            "lineWidth": 1,
