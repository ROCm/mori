    {
      "type": "timeseries",
      "title": "Resolve hit rate by medium",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 22
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 0,
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": true
          },
          "color": {
            "mode": "palette-classic"
          },
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "sum by (tier) (rate(mori_umbp_backend_ops_total{node=~\"$node\", tier=~\"$tier\", op=\"resolve\", status=\"ok\"}[$__rate_interval])) / clamp_min(sum by (tier) (rate(mori_umbp_backend_ops_total{node=~\"$node\", tier=~\"$tier\", op=\"resolve\"}[$__rate_interval])), 1e-9)",
          "legendFormat": "{{tier}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "description": "Hits over hits+misses at the backend boundary. A medium whose hit rate collapses is either being asked for keys it never held or is losing them to eviction.",
      "id": 16
    },
    {
      "type": "timeseries",
      "title": "Mean call latency by medium and op",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 22
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 0,
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": true
          },
          "color": {
            "mode": "palette-classic"
          },
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "sum by (tier, op) (rate(mori_umbp_backend_op_seconds_total{node=~\"$node\", tier=~\"$tier\"}[$__rate_interval])) / clamp_min(sum by (tier, op) (rate(mori_umbp_backend_batches_total{node=~\"$node\", tier=~\"$tier\"}[$__rate_interval])), 1e-9)",
          "legendFormat": "{{tier}} {{op}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "description": "Seconds spent inside the medium per batch call. Measured by the decorator, so it excludes the network and isolates the medium itself.",
      "id": 17
    },
    {
      "type": "timeseries",
      "title": "Mean batch depth by medium and op",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 22
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 0,
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": true
          },
          "color": {
            "mode": "palette-classic"
