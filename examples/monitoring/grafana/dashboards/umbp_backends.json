      "targets": [
        {
          "expr": "sum by (tier) (rate(mori_umbp_backend_bytes_total{node=~\"$node\", tier=~\"$tier\", op=\"resolve\"}[$__rate_interval]))",
          "legendFormat": "{{tier}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
