      "targets": [
        {
          "expr": "sum by (tier) (rate(mori_umbp_backend_bytes_total{node=~\"$node\", tier=~\"$tier\", op=\"commit\"}[$__rate_interval]))",
          "legendFormat": "{{tier}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "description": "Bytes committed into each medium. Logical bytes \u2014 see the medium-internal panel below for what actually reached a device.",
      "id": 14
    },
    {
      "type": "timeseries",
      "title": "Read bandwidth by medium",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
