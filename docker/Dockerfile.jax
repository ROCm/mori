# JAX CI image: AMD's ROCm JAX release image plus what mori's build needs.
#
# ROCm comes from the image's pip rocm-sdk wheels, and rocm-sdk-devel carries a
# full dev tree (CMake configs, hsakmt, hipcc), so unlike docker/Dockerfile.dev no
# apt ROCm goes on top. The image's ROCM_PATH names the rocm-sdk-core tree, which
# has no CMake configs, so the devel tree is linked to /opt/rocm -- the root
# mori's build and runtime JIT default to -- and ROCM_PATH follows it.
ARG BASE_IMAGE=rocm/jax:rocm10.0-jax0.10.2-py3.11
FROM ${BASE_IMAGE}

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    libibverbs-dev libnuma-dev libdrm-dev && \
    rm -rf /var/lib/apt/lists/*

RUN ln -s "$(python3 -m rocm_sdk path --root)" /opt/rocm && \
    test -e /opt/rocm/lib/cmake/hip-lang/hip-lang-config.cmake
ENV ROCM_PATH=/opt/rocm HIP_PATH=/opt/rocm ROCM_HOME=/opt/rocm

# The amdgpu workaround docker/Dockerfile.dev explains; the symmetric heap
# allocates the same way under JAX.
ENV MALLOC_MMAP_THRESHOLD_=131072
